    if input.KeyCode == Enum.KeyCode.Delete then
        cleanupAll()
    end
end)

-- =======================================================
-- LOOP PRINCIPAL (RENDERSTEPPED)
-- =======================================================
RunService:BindToRenderStep("DavizinLoop", Enum.RenderPriority.Camera.Value + 1, function()
    FOVring.Position = Cam.ViewportSize / 2
    FOVring.Radius = Settings.FOV

    if Settings.AimbotEnabled then
        local closest = getClosestPlayerInFOV("Head")
        if closest and closest.Character and closest.Character:FindFirstChild("Head") then
            lookAt(closest.Character.Head.Position)
        end
    end

    for player, drawings in pairs(espDrawings) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local head = character and character:FindFirstChild("Head")

        if character and rootPart and humanoid and humanoid.Health > 0 then
            local vector, onScreen = Cam:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                local topPosition = head and Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                local legPosition = Cam:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

                local height = math.abs(topPosition.Y - legPosition.Y)
                local width = height / 2

                if Settings.ESPBox then
                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(vector.X - width / 2, topPosition.Y)
                    drawings.Box.Color = Settings.ESPColor
                    drawings.Box.Visible = true
                else
                    drawings.Box.Visible = false
                end

                if Settings.ESPLine then
                    drawings.Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    drawings.Line.To = Vector2.new(vector.X, legPosition.Y)
                    drawings.Line.Color = Settings.ESPColor
                    drawings.Line.Visible = true
                else
                    drawings.Line.Visible = false
                end

                if Settings.ESPName then
                    drawings.Name.Text = player.Name
                    drawings.Name.Position = Vector2.new(vector.X, topPosition.Y - 16)
                    drawings.Name.Visible = true
                else
                    drawings.Name.Visible = false
                end

                if Settings.ESPHealth then
                    local barWidth = 3
                    local healthPercentage = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barHeight = height * healthPercentage

                    drawings.HealthOutline.Size = Vector2.new(barWidth + 2, height + 2)
                    drawings.HealthOutline.Position = Vector2.new(vector.X - (width / 2) - barWidth - 5, topPosition.Y - 1)
                    drawings.HealthOutline.Visible = true

                    drawings.HealthBar.Size = Vector2.new(barWidth, barHeight)
                    drawings.HealthBar.Position = Vector2.new(vector.X - (width / 2) - barWidth - 4, topPosition.Y + (height - barHeight))
                    drawings.HealthBar.Color = Color3.fromRGB(255 - (255 * healthPercentage), 255 * healthPercentage, 0)
                    drawings.HealthBar.Visible = true
                else
                    drawings.HealthOutline.Visible = false
                    drawings.HealthBar.Visible = false
                end
            else
                drawings.Box.Visible = false
                drawings.Line.Visible = false
                drawings.Name.Visible = false
                drawings.HealthOutline.Visible = false
                drawings.HealthBar.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Line.Visible = false
            drawings.Name.Visible = false
            drawings.HealthOutline.Visible = false
            drawings.HealthBar.Visible = false
        end
    end
end)
