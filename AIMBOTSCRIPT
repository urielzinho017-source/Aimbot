-- =======================================================
-- ESP SYSTEM
-- =======================================================
local espDrawings = {}

local function createESP(player)
    if espDrawings[player] then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1.5
    box.Color = Settings.ESPColor
    box.Filled = false

    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = 1.5
    line.Color = Settings.ESPColor

    local name = Drawing.new("Text")
    name.Visible = false
    name.Size = 14
    name.Center = true
    name.Outline = true
    name.Color = Color3.fromRGB(255, 255, 255)

    local healthOutline = Drawing.new("Square")
    healthOutline.Visible = false
    healthOutline.Thickness = 1
    healthOutline.Color = Color3.fromRGB(0, 0, 0)
    healthOutline.Filled = true

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Thickness = 1
    healthBar.Color = Color3.fromRGB(0, 255, 0)
    healthBar.Filled = true

    espDrawings[player] = {
        Box = box,
        Line = line,
        Name = name,
        HealthOutline = healthOutline,
        HealthBar = healthBar
    }
end

local function removeESP(player)
    if espDrawings[player] then
        for _, obj in pairs(espDrawings[player]) do
            obj:Remove()
        end
        espDrawings[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then createESP(p) end
end)
Players.PlayerRemoving:Connect(removeESP)

-- =======================================================
-- FUNÇÕES DO AIMBOT
-- =======================================================
local function lookAt(target)
    local lookVector = (target - Cam.CFrame.Position).Unit
    Cam.CFrame = CFrame.new(Cam.CFrame.Position, Cam.CFrame.Position + lookVector)
end

local function getClosestPlayerInFOV(trg_part)
    local nearest = nil
    local last = math.huge
    local playerMousePos = Cam.ViewportSize / 2

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local part = player.Character:FindFirstChild(trg_part)
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if part and humanoid and humanoid.Health > 0 then
                local ePos, isVisible = Cam:WorldToViewportPoint(part.Position)
                local distance = (Vector2.new(ePos.X, ePos.Y) - playerMousePos).Magnitude

                if distance < last and isVisible and distance < Settings.FOV then
                    last = distance
                    nearest = player
                end
            end
        end
    end
    return nearest
end

